# --- WHATSAPP CLOUD API (META) ---
# Token de acceso permanente o temporal generado en Meta for Developers
WHATSAPP_TOKEN=tu_token_de_meta_aqui
# El ID del número de teléfono (no es el número en sí, es el ID que da Meta)
WHATSAPP_PHONE_ID=tu_phone_id_aqui
# Token de verificación inventado por ti para configurar el Webhook en Meta
WEBHOOK_VERIFY_TOKEN=truckcenter_token_secreto_2026

# --- GOOGLE GEMINI ---
GEMINI_API_KEY=tu_api_key_de_google_aqui

# --- NOTION CRM ---
NOTION_TOKEN=tu_token_de_integracion_notion_aqui
NOTION_DATABASE_ID=tu_id_de_base_de_datos_aqui
