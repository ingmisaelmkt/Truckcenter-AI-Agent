# --- WHATSAPP CLOUD API (META) ---
# Solo se usa hoy para /webhook (pruebas locales directas contra Meta).
# En producción, Meta apunta a wacrm, no a este servicio directamente.
WHATSAPP_TOKEN=tu_token_de_meta_aqui
WHATSAPP_PHONE_ID=tu_phone_id_aqui
WEBHOOK_VERIFY_TOKEN=truckcenter_token_secreto_2026

# --- GOOGLE GEMINI ---
GEMINI_API_KEY=tu_api_key_de_google_aqui

# --- WACRM ---
# Secreto compartido que wacrm envía como "Authorization: Bearer <secreto>"
# al llamar a POST /api/chat. Genera uno largo (ej: openssl rand -hex 32) y
# pégalo también en wacrm -> Settings -> AI Assistant -> Shared secret.
WACRM_SHARED_SECRET=genera-un-secreto-largo-aqui
# Dominio real de tu wacrm, SIN slash final.
WACRM_BASE_URL=https://tu-wacrm.ejemplo.com
# API key creada en wacrm -> Settings -> API keys, con scopes
# messages:send y contacts:write.
WACRM_API_KEY=wacrm_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio público de ESTE agente (donde corre este mismo servicio en
# EasyPanel), SIN slash final — se usa para que wacrm/Meta puedan
# descargar los PDF de cotización desde /quotes/<archivo>.pdf.
PUBLIC_BASE_URL=https://tu-agente.ejemplo.com

# --- BSALE ---
BSALE_API_TOKEN=tu_token_de_bsale_aqui
# ID del tipo de documento "Cotización" (o "Nota de Venta") en TU cuenta.
# Se obtiene con:
#   curl -H "access_token: TU_BSALE_API_TOKEN" https://api.bsale.cl/v1/document_types.json
BSALE_QUOTE_DOCUMENT_TYPE_ID=
# Opcional — ID de la sucursal donde se emiten los documentos. Si se deja
# vacío, Bsale usa la sucursal por defecto de la cuenta.
BSALE_OFFICE_ID=

# --- NOTION (actualmente sin usar) ---
# agent.py ya no llama a notion_tools.py — el registro de leads quedó
# migrado a wacrm (ver wacrm_tools.py). El archivo notion_tools.py sigue
# en el repo por si se retoma más adelante; estas variables no son
# necesarias mientras tanto.
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
